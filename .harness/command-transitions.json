          "canonical": "GIT SYNC",
          "chainAllowed": false,
          "target": "none",
          "input": "none",
          "summary": "Показать divergence или выполнить разрешённый ff-only sync.",
          "documentation": ".harness/docs/COMMANDS.md#command-git-sync"
