          "documentation": ".harness/docs/COMMANDS.md#command-project-init"
        },
        "STATUS": {
          "canonical": "PROJECT STATUS",
          "chainAllowed": false,
          "target": "none",
          "input": "none",
          "summary": "Показать актуальное состояние проекта, blockers и доступную работу.",
          "documentation": ".harness/docs/COMMANDS.md#command-project-status"
        },
        "RECONCILE": {
          "canonical": "PROJECT RECONCILE",
          "chainAllowed": false,
          "target": "none",
          "input": "none",
          "summary": "Сверить project artifacts с фактическим repository state и создать corrective work.",
          "documentation": ".harness/docs/COMMANDS.md#command-project-reconcile"
        },
        "QUICK FIX": {
          "canonical": "PROJECT QUICK FIX:",
          "chainAllowed": false,
          "target": "none",
          "input": "required",
