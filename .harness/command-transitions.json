        {
          "from": "CHECK",
          "to": "PUSH",
          "onPreviousResult": [
            "PASS"
          ],
          "runtimePreconditions": [
            "git-push-ready"
          ]
        },
        {
          "from": "CHECK",
          "to": "PR",
          "onPreviousResult": [
            "PASS"
          ],
          "runtimePreconditions": [
            "git-pr-ready"
          ]
        },
        {
          "from": "COMMIT",
          "to": "PUSH",
          "onPreviousResult": [
            "SUCCESS"
          ],
          "runtimePreconditions": []
        },
        {
          "from": "PUSH",
          "to": "PR",
          "onPreviousResult": [
            "SUCCESS"
          ],
          "runtimePreconditions": []
        }
      ]
