        "RUN": {
          "canonical": "STEP RUN STEP-NNN",
          "chainAllowed": false,
          "target": "step",
          "input": "none",
          "summary": "Автоматически провести STEP через PLAN, IMPLEMENT, REVIEW и FIX cycles.",
