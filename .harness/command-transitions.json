          "canonical": "STEP FIX STEP-NNN",
          "chainAllowed": true,
          "target": "step",
          "input": "none",
          "summary": "Исправить подтверждённые findings последнего FAIL review.",
          "documentation": ".harness/docs/COMMANDS.md#command-step-fix"
