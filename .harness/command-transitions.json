        "PR FINISH": {
          "canonical": "GIT PR FINISH",
          "chainAllowed": false,
          "target": "none",
          "input": "none",
          "summary": "Завершить локальный PR lifecycle после merge: вернуть return branch и удалить локальную PR-ветку.",
          "documentation": ".harness/docs/COMMANDS.md#command-git-pr-finish"
