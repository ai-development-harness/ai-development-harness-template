{
  "schemaVersion": 1,
  "stateDirectory": ".project/local/execution",
  "authorityOrder": [
    "canonical-artifacts",
    "local-execution-cursor"
  ],
  "atomicWrites": true,
  "interruptedDefault": "retry-same-command",
  "stepRun": {
    "phases": [
      {
        "operation": "PLAN",
        "command": "STEP PLAN STEP-NNN",
        "completionProof": "plan-ready-current-basis",
        "interrupted": "retry-or-skip-if-proven"
      },
      {
        "operation": "IMPLEMENT",
        "command": "STEP IMPLEMENT STEP-NNN",
        "completionProof": "local-completed-checkpoint",
        "interrupted": "resume-same-command"
      },
      {
        "operation": "REVIEW",
        "command": "STEP REVIEW STEP-NNN",
        "completionProof": "new-immutable-review-report",
        "interrupted": "retry-or-resolve-if-proven"
      },
      {
        "operation": "FIX",
        "command": "STEP FIX STEP-NNN",
        "completionProof": "local-completed-checkpoint",
        "interrupted": "resume-same-command"
      }
    ],
    "completionProof": "step-status-completed",
    "finalizeCommand": "STEP RUN STEP-NNN",
    "fixReviewLimitSource": ".project/manifest.yaml:execution.maxFixReviewCycles"
  }
}
